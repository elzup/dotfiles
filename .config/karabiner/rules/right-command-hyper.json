{
  "title": "dotfiles: right command",
  "rules": [
    {
      "description": "dotfiles: right_command → command+option+shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_command",
              "modifiers": ["left_option", "left_shift"]
            }
          ]
        }
      ]
    }
  ]
}
